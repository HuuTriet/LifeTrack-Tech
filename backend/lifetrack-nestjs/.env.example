# ===========================
# Application
# ===========================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ===========================
# Database (MySQL)
# ===========================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=lifetrack_secret
DB_NAME=lifetrack_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ===========================
# JWT
# ===========================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# ===========================
# Redis (Cache)
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# ===========================
# Consul (Service Discovery)
# ===========================
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_NAME=lifetrack-medication-service
SERVICE_ID=lifetrack-medication-service-1
SERVICE_HOST=localhost
SERVICE_PORT=3001
CONSUL_HEALTH_CHECK_INTERVAL=10s
CONSUL_HEALTH_CHECK_TIMEOUT=5s

# ===========================
# Python OCR Service
# ===========================
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_GRPC_HOST=localhost
OCR_SERVICE_GRPC_PORT=50051
OCR_TIMEOUT_MS=10000

# ===========================
# Drug Interaction API (Third-party)
# ===========================
DRUG_INTERACTION_API_URL=https://api.druginteractions.example.com/v1
DRUG_INTERACTION_API_KEY=your_drug_api_key_here
DRUG_INTERACTION_TIMEOUT_MS=5000

# ===========================
# Kong API Gateway
# ===========================
KONG_ADMIN_URL=http://localhost:8001

# ===========================
# CORS
# ===========================
CORS_ORIGIN=http://localhost:3000
