{
  "manifest_version": 3,
  "name": "LifeTrack Tech — Nhắc uống thuốc",
  "version": "1.0.0",
  "description": "Nhắc uống thuốc cho người cao tuổi. Kết nối với ứng dụng LifeTrack Tech.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png"
    },
    "default_title": "LifeTrack — Nhắc thuốc"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ]
}
